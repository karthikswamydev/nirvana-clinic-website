# Production build (`npm run build`). Replace with real values on your host’s
# env UI (Vercel, Netlify, etc.) — those override this file when set at build time.
# EmailJS template fields: from_name, from_email, phone, message

VITE_EMAILJS_PUBLIC_KEY=dummy_public_key_replace_in_host_env
VITE_EMAILJS_SERVICE_ID=dummy_service_id_replace_in_host_env
VITE_EMAILJS_TEMPLATE_ID=dummy_template_id_replace_in_host_env
